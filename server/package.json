    "exceljs": "4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "0.31.11",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
